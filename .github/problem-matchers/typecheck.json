{
  "problemMatcher": [
    {
      "owner": "typecheck",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(?:ERROR|WARN(?:ING)?)\\s+([^:]+):(\\d+):(\\d+)(?:-\\d+)?:\\s+(.*?)(?:\\s+\\[(\\S+)\\])?$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4,
          "code": 5
        }
      ]
    }
  ]
}
